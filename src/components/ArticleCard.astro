---
import type { CollectionEntry } from 'astro:content';
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { title, description, pubDate, sourceName, tags } = article.data;
---
<article class="card">
  <p class="meta">
    <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
    · via {sourceName}
  </p>
  <h2><a href={`/articles/${article.id}/`}>{title}</a></h2>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tags">{tags.map((t) => <li><a href={`/tags/${t}/`}>#{t}</a></li>)}</ul>
  )}
</article>
