---
// One ad unit. Renders nothing in production unless PUBLIC_AD_PROVIDER is set.
// Placement is deliberately limited: 2 per article page (in-article + sidebar), 1 on list pages.
interface Props {
  placement: 'inarticle' | 'sidebar' | 'feed';
}
const { placement } = Astro.props;
const provider = import.meta.env.PUBLIC_AD_PROVIDER ?? 'none';
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slots: Record<string, string | undefined> = {
  inarticle: import.meta.env.PUBLIC_ADSENSE_SLOT_INARTICLE,
  sidebar: import.meta.env.PUBLIC_ADSENSE_SLOT_SIDEBAR,
  feed: import.meta.env.PUBLIC_ADSENSE_SLOT_FEED,
};
const slot = slots[placement];
const isDev = import.meta.env.DEV;
---
{provider === 'adsense' && client && slot && (
  <aside class="ad" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot}
      data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
{provider === 'ethicalads' && import.meta.env.PUBLIC_ETHICALADS_PUBLISHER && (
  <aside class="ad" aria-label="Advertisement">
    <div data-ea-publisher={import.meta.env.PUBLIC_ETHICALADS_PUBLISHER} data-ea-type="image"
      class="horizontal" id={`ea-${placement}`}></div>
  </aside>
)}
{provider === 'none' && isDev && (
  <aside class="ad ad-placeholder" aria-hidden="true">Ad slot: {placement}</aside>
)}
